-        if (search.Length > 0)
-        {
-            query = query.Where(x =>
-                x.CompanyCode.Contains(search) ||
-                x.CompanyName.Contains(search) ||
-                (x.ContactPerson != null && x.ContactPerson.Contains(search)) ||
-                (x.Mobile != null && x.Mobile.Contains(search)) ||
