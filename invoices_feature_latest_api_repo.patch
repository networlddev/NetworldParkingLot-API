+    private static string FormatDuration(TimeSpan span)
+    {
+        if (span.TotalDays >= 1)
+            return $"{(int)span.TotalDays} days {span.Hours} hours";
+        if (span.TotalHours >= 1)
+            return $"{(int)span.TotalHours} hours {span.Minutes} minutes";
+        return $"{span.Minutes} minutes";
+    }
